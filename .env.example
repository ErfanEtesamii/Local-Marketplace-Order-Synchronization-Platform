# --- General ---
LOG_LEVEL=INFO
DB_PATH=./data/sync.db
POLL_INTERVAL_SECONDS=120

# --- Tapsi Shop ---
TAPSISHOP_BASE_URL=https://vendorgw.tapsi.shop
TAPSISHOP_AUTH_TOKEN=
TAPSISHOP_WEBHOOK_TOKEN=
# Currency unit Tapsi Shop's API returns prices in - "toman" or "rial".
# UNCONFIRMED (not stated anywhere in the vendor's API doc) - defaults
# to "rial" (no conversion) until someone checks a real order amount
# against what it should actually be. See src/currency.py.
TAPSISHOP_PRICE_UNIT=rial

# --- Telegram Notifications ---
# Telegram notifications - get your bot token from @BotFather. Set the
# token plus at least one chat id below to enable per-order
# notifications and daily/weekly/monthly reports; leave the token or
# every chat id blank to disable the feature entirely (it no-ops
# safely, it never crashes the sync process).
TELEGRAM_BOT_TOKEN=
# Up to 10 recipients - every one of them gets every notification and
# report, independently (one bad/blocked chat never stops the others).
# Each is either a numeric chat id (get yours by having that person/bot
# message your bot, e.g. /start, then checking
# https://api.telegram.org/bot<token>/getUpdates) or a
# "@channel_username" string to post into a channel the bot
# administers. Leave any of the 10 blank - only non-blank ones count.
TELEGRAM_CHAT_ID_1=
TELEGRAM_CHAT_ID_2=
TELEGRAM_CHAT_ID_3=
TELEGRAM_CHAT_ID_4=
TELEGRAM_CHAT_ID_5=
TELEGRAM_CHAT_ID_6=
TELEGRAM_CHAT_ID_7=
TELEGRAM_CHAT_ID_8=
TELEGRAM_CHAT_ID_9=
TELEGRAM_CHAT_ID_10=

# --- Digikala ---
DIGIKALA_BASE_URL=https://seller.digikala.com
DIGIKALA_CLIENT_CODE=
DIGIKALA_CLIENT_SECRET=
DIGIKALA_ACCESS_TOKEN=
DIGIKALA_REFRESH_TOKEN=
# Currency unit Digikala's API returns prices in - "toman" or "rial".
# Digikala's web service is documented elsewhere as Rial-based (not
# from Digikala's own docs directly - see src/currency.py for the
# source/confidence level).
DIGIKALA_PRICE_UNIT=rial

# --- SnappShop ---
# DISABLED by default (client request, 2026-08 - no API access granted
# yet). Set to true once real credentials exist below; until then this
# source is left out of the poll loop entirely rather than failing
# every cycle with a config/connection error.
SNAPPSHOP_ENABLED=false
# Base URL not stated explicitly in the vendor docs excerpts we have -
# apix.snappshop.ir is inferred from Snapp's public bug-bounty domain
# scope list, NOT confirmed from official docs. Verify against
# "تنظیمات فروشگاه » مشاهده و ثبت API" in the seller panel before use.
SNAPPSHOP_BASE_URL=https://apix.snappshop.ir
SNAPPSHOP_AUTH_TOKEN=
SNAPPSHOP_AGENT_USER=
SNAPPSHOP_VENDOR_ID=
# Currency unit SnappShop's API returns prices in - "toman" or "rial".
# UNCONFIRMED (the two vendor blog posts we have don't state one) -
# defaults to "rial" (no conversion) until someone checks a real order
# amount against what it should actually be. See src/currency.py.
SNAPPSHOP_PRICE_UNIT=rial

# --- Basalam (official Order Processing Service - Personal Access Token) ---
# Issue from developers.basalam.com/panel with scope: vendor.parcel.read
BASALAM_BASE_URL=https://order-processing.basalam.com
BASALAM_ACCESS_TOKEN=
# Currency unit Basalam's API returns prices in - "toman" or "rial".
# Best-guess default based on the official Basalam SDK's quick-start
# example printing a product's price with "تومان" - NOT confirmed
# against a real live parcel/order payload. See src/currency.py.
BASALAM_PRICE_UNIT=rial

# --- Faraz Honar (own WordPress/WooCommerce site - admin access) ---
# Generate from wp-admin: WooCommerce > Settings > Advanced > REST API
# (Read permission is enough)
FARAZHONAR_BASE_URL=https://farazhonar.com
FARAZHONAR_CONSUMER_KEY=
FARAZHONAR_CONSUMER_SECRET=
# Currency unit Faraz Honar's store prices are in - "toman" or "rial".
# Confirmed by the client checking real order data (2026-08-29):
# WooCommerce billing/line-item prices here are in Toman.
FARAZHONAR_PRICE_UNIT=toman

# --- Didar CRM ---
DIDAR_BASE_URL=https://app.didar.me/api
DIDAR_API_KEY=
DIDAR_API_ID=
DIDAR_BIZDOMAIN_ID=
# Confirmed via GetPipelineList: "سفارشات" pipeline
DIDAR_PIPELINE_ID=16403ed0-efa3-4b7d-a041-408aedc6994d
# Stage: currently "مشتری جدید". If you want new orders to land in
# "درحال بررسی" instead (id below), update this value on the LIVE
# server's .env - this file is only a template and isn't read directly.
#   مشتری جدید:    7ecedf77-419f-415d-95f7-f43bd1672814  (current default)
#   درحال بررسی:   84adbb58-3171-42f4-bf07-18a37e68af0b
DIDAR_PIPELINE_STAGE_ID=7ecedf77-419f-415d-95f7-f43bd1672814
# Required whenever a new Product is auto-created in the catalog
# (src/didar/product_client.py) - /product/save fails with
# "product category is empty" without a ProductCategoryId. This project
# doesn't map marketplace categories to Didar categories, so every
# auto-created product is filed under one fixed catch-all category.
# Get a real Id by calling (confirmed in Didar's API docs):
#   POST {DIDAR_BASE_URL}/product/categories?apikey={DIDAR_API_KEY}
# -> {"Response": [{"Id": "...", "Title": "..."}, ...]} - pick whichever
# category makes sense as a generic default (e.g. "سایر" / "متفرقه").
DIDAR_DEFAULT_PRODUCT_CATEGORY_ID=83ed7427-f696-42e3-b361-376509581045

# Optional: path to the client's Excel export of the existing Didar
# product catalog (columns: عنوان محصول / کد محصول). When set, each
# order item's marketplace title is matched against this file first to
# recover the product's REAL Didar Code - see src/didar/product_catalog.py.
# Leave blank to disable this and fall back to marketplace SKU/title
# (the original behaviour).
DIDAR_PRODUCT_CATALOG_XLSX=./data/didar_product_catalog.xlsx
# Deal Labels per marketplace source (NOT Tags - a different Didar
# concept, confirmed 2026-09 directly from Didar's own support agent).
# Fetch and inspect the real list via:
#   GET {DIDAR_BASE_URL}/Label/GetDealLabels?apikey={DIDAR_API_KEY}
# then set each Title EXACTLY as it appears there (matching is exact,
# after Persian normalization) - these are TITLES, not GUIDs; the code
# resolves each to its Id itself (see DidarDealClient._label_id_for_source
# / DidarConfig.deal_label_title_by_source). "سایت فرازهنر" below is
# CONFIRMED from a screenshot of this account's real Deal Labels; the
# other four are best guesses and should be checked against the live
# list above. Leave any blank to skip labeling that source's Deals
# entirely (not an error).
DIDAR_DEAL_LABEL_TITLE_TAPSISHOP=تپسی
DIDAR_DEAL_LABEL_TITLE_DIGIKALA=دیجی کالا
DIDAR_DEAL_LABEL_TITLE_SNAPPSHOP=اسنپ
DIDAR_DEAL_LABEL_TITLE_BASALAM=باسلام
DIDAR_DEAL_LABEL_TITLE_FARAZHONAR=سایت فرازهنر
# Optional - who newly-created Deals/Activities are owned by. Deal
# creation already works fine without this (Activity.OwnerId is
# similarly optional - see src/didar/activity_client.py), so leave
# blank unless you specifically want everything owned by one user
# rather than whoever the API key defaults to.
DIDAR_DEFAULT_OWNER_ID=
# Post-sale checklist (client feedback, 2026-08): every new Deal
# automatically gets the same 6-item follow-up checklist the sales team
# already builds by hand (see src/didar/activity_client.py). Confirmed
# live via POST {DIDAR_BASE_URL}/activity/GetActivityType?apikey=... -
# this account has one dedicated ActivityType per checklist item
# already, so these map one-to-one rather than sharing generic
# call/sms/task buckets. Re-run that endpoint if the account's type
# list ever changes. Leave ANY of the six blank and the WHOLE checklist
# is skipped (logged as a warning) - not partially created.
DIDAR_ACTIVITY_TYPE_NEW_CALL_ID=0b6bff2b-d962-4fa1-8a05-4933c3993e56
DIDAR_ACTIVITY_TYPE_SMS1_ID=7cf18b21-8f11-47d0-bf52-04d7ab6f2188
DIDAR_ACTIVITY_TYPE_SMS2_ID=bc552007-25b9-4a17-920c-a2138354f309
DIDAR_ACTIVITY_TYPE_SMS3_ID=ed1a4b3e-8e4b-424d-a7dd-3b86c3bf01eb
DIDAR_ACTIVITY_TYPE_SHIP_ID=2cd995e3-95bf-4bd2-aa59-1d09111d80a2
DIDAR_ACTIVITY_TYPE_SATISFACTION_CALL_ID=fdcdcd51-0cad-4d2e-a2c3-f984e322ba14

# CONFIRMED (2026-09) directly from Didar's own support agent: product
# photos attach via a dedicated two-step flow - create the Activity
# first (as above), then POST the file to this endpoint as
# multipart/form-data with "activityId" (the Id from step 1) and the
# file under "uploads". This supersedes an earlier, never-verified
# guess (POST /file/upload + Activity.save's NewAttachments) that did
# not match Didar's documented flow. The default below is the
# confirmed path - no override needed unless you need a custom
# configuration. See DidarConfig.attach_files_to_activity_path /
# DidarActivityClient.attach_photo_to_activity() in src/config.py and
# src/didar/activity_client.py.
DIDAR_ATTACH_FILES_TO_ACTIVITY_PATH=/activity/AttachFilesToActivity

# CONFIRMED (client-supplied Didar documentation, 2026-09): resolves a
# customer's raw province/city NAME (from a marketplace order) to
# Didar's own ProvinceId/CityId, needed to save a Contact's full
# address - see src/didar/contact_client.py's list_locations()/
# _resolve_location_ids(). Unlike every other Didar path in this file,
# this call takes NO apikey query param and NO request body. The
# client's own docs write this path with a leading "/api"
# ("{{baseURL}}/api/shared/GetLocations") - but DIDAR_BASE_URL above
# already ends in "/api", same as every other path in this file, so
# it's written here without it. If this ever 404s, that doubled "/api"
# is the first thing to check (see DidarConfig.get_locations_path).
DIDAR_GET_LOCATIONS_PATH=/shared/GetLocations