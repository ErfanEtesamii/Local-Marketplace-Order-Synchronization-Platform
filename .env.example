# --- General ---
LOG_LEVEL=INFO
DB_PATH=./data/sync.db
POLL_INTERVAL_SECONDS=120

# --- Tapsi Shop ---
TAPSISHOP_BASE_URL=https://vendorgw.tapsi.shop
TAPSISHOP_AUTH_TOKEN=
TAPSISHOP_WEBHOOK_TOKEN=

# --- Digikala ---
DIGIKALA_BASE_URL=https://seller.digikala.com
DIGIKALA_CLIENT_CODE=
DIGIKALA_CLIENT_SECRET=
DIGIKALA_ACCESS_TOKEN=
DIGIKALA_REFRESH_TOKEN=

# --- SnappShop ---
# Base URL not stated explicitly in the vendor docs excerpts we have -
# apix.snappshop.ir is inferred from Snapp's public bug-bounty domain
# scope list, NOT confirmed from official docs. Verify against
# "تنظیمات فروشگاه » مشاهده و ثبت API" in the seller panel before use.
SNAPPSHOP_BASE_URL=https://apix.snappshop.ir
SNAPPSHOP_AUTH_TOKEN=
SNAPPSHOP_AGENT_USER=
SNAPPSHOP_VENDOR_ID=

# --- Basalam (official Order Processing Service - Personal Access Token) ---
# Issue from developers.basalam.com/panel with scope: vendor.parcel.read
BASALAM_BASE_URL=https://order-processing.basalam.com
BASALAM_ACCESS_TOKEN=

# --- Faraz Honar (own WordPress/WooCommerce site - admin access) ---
# Generate from wp-admin: WooCommerce > Settings > Advanced > REST API
# (Read permission is enough)
FARAZHONAR_BASE_URL=https://farazhonar.com
FARAZHONAR_CONSUMER_KEY=
FARAZHONAR_CONSUMER_SECRET=

# --- Didar CRM ---
DIDAR_BASE_URL=https://app.didar.me/api
DIDAR_API_KEY=
DIDAR_PIPELINE_ID=
DIDAR_PIPELINE_STAGE_ID=
